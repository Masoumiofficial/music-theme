{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "wavira/artist-gallery",
	"title": "Artist photo gallery",
	"category": "wavira-music",
	"description": "Photos attached to an artist: the images uploaded on the artist screen.",
	"keywords": [
		"artist",
		"gallery",
		"photos",
		"images",
		"music"
	],
	"textdomain": "wavira",
	"attributes": {
		"artistId": {
			"type": "number",
			"default": 0
		},
		"limit": {
			"type": "number",
			"default": 12
		},
		"columns": {
			"type": "number",
			"default": 3
		}
	},
	"supports": {
		"html": false
	},
	"render": "file:./render.php",
	"usesContext": [
		"postId"
	]
}
