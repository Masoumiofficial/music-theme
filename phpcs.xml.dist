<?xml version="1.0"?>
<ruleset name="Wavira">
	<description>Coding standards for the Wavira theme and core plugin.</description>

	<file>wavira</file>
	<file>wavira-core</file>

	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/assets/dist/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>
	<arg name="parallel" value="8"/>

	<!-- Baseline: WordPress Coding Standards. -->
	<rule ref="WordPress-Core"/>
	<rule ref="WordPress-Docs"/>
	<rule ref="WordPress-Extra"/>

	<!-- PHP compatibility with the declared floor (ADR 0007). -->
	<rule ref="PHPCompatibilityWP"/>
	<config name="testVersion" value="7.4-"/>

	<!-- Text domains must match the artifact (ADR 0008). -->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="wavira"/>
				<element value="wavira-core"/>
			</property>
		</properties>
	</rule>

	<!-- PSR-4 file naming for plugin classes. -->
	<rule ref="WordPress.Files.FileName">
		<properties>
			<property name="strict_class_file_names" value="true"/>
		</properties>
	</rule>

	<!-- Deliberate, documented relaxations. -->
	<!-- The plugin uses PSR-4 autoloading with namespaced classes. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="wavira"/>
				<element value="Wavira"/>
			</property>
		</properties>
	</rule>

	<!-- Rules from CODING-STANDARD.md that must never regress are enforced by tooling:
	     no posts_per_page -1, no srcset disabling, no wp_is_mobile layout sniffing,
	     no deprecated APIs. Those are checked by tools/lint.sh (grep gate) in CI. -->

	<rule ref="Generic.CodeAnalysis.UselessOverridingMethod"/>
	<rule ref="Generic.CodeAnalysis.EmptyStatement"/>
</ruleset>
